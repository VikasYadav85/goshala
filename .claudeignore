# .claudeignore — files/dirs Claude Code should skip when reading the codebase.
# Goal: protect the context window from junk (deps, build output, binaries, logs).
# Each entry is commented with WHY it's excluded.

# ── Dependencies (huge, never read by hand) ──────────────────────────────
node_modules/        # npm packages — thousands of files, never hand-read
vendor/              # Composer packages (Laravel framework + libs) — read via docs, not source

# ── Build / compiled output (generated, not source of truth) ─────────────
public/build/        # Vite production build output (hashed JS/CSS)
public/hot           # Vite HMR marker file
public/storage       # symlink to storage/app/public (generated by storage:link)
*.min.js             # minified JS — unreadable, generated
*.min.css            # minified CSS — unreadable, generated
*.map                # source maps — generated
*.chunk.*            # code-split chunks — generated

# ── Laravel framework caches (regenerated on demand) ─────────────────────
bootstrap/cache/     # compiled service/package manifests — generated
storage/framework/   # compiled views, sessions, cache — generated
storage/logs/        # application logs — noise, not source

# ── Large data / uploads / backups (binary or bulky, not code) ───────────
storage/app/         # user uploads + app files — binary/bulky
database/*.sqlite     # SQLite DB binary (local dev data)
database/*.sqlite-journal
*.sql                # DB dumps / backups
dumps/               # DB dumps
backups/             # backups

# ── Media / binary assets (not text, waste context) ──────────────────────
image/               # bundled image assets (binary)
public/images/       # served images (binary)
public/img/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.woff
*.woff2
*.ttf
*.eot
*.pdf

# ── Test coverage output (generated reports) ─────────────────────────────
coverage/            # coverage HTML/data
.phpunit.cache/      # PHPUnit result cache
.phpunit.result.cache

# ── Lock files (machine-managed, enormous, rarely need reading) ──────────
package-lock.json    # npm lockfile — generated, huge
composer.lock        # Composer lockfile — generated, huge
yarn.lock
bun.lock

# ── Logs ─────────────────────────────────────────────────────────────────
*.log                # any log file — noise
logs/

# ── IDE / OS cruft ───────────────────────────────────────────────────────
.idea/               # JetBrains config
.vscode/             # editor config (launch.json etc.)
.DS_Store            # macOS Finder metadata
Thumbs.db            # Windows thumbnail cache

# ── Env files (secrets — never read into context) ────────────────────────
.env                 # real secrets
.env.bak*            # env backups created during deploys
