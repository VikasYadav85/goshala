APP_NAME="Gopal Samarpan Sewa Charitable Trust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo HTTP-API mailer (use on hosts that block outbound SMTP, e.g. DigitalOcean).
# Set MAIL_MAILER=brevo and MAIL_FROM_ADDRESS to a Brevo-verified sender.
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payments
# Razorpay (optional gateway). Leave as placeholders to disable.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_CURRENCY=INR
# UPI direct collection (QR + VPA shown on the donation pay page)
UPI_VPA=
UPI_PAYEE_NAME="${APP_NAME}"

# Trust details (shown on the site + 80G receipts). Address = goshala/visiting
# address; registered office = trust-deed address (used on 80G receipts).
TRUST_EMAIL=
TRUST_PHONE=
TRUST_WHATSAPP=
TRUST_ADDRESS="Gram Kukudipur, Post Saidpur Gadaur, Tehsil Sadar, Jaunpur, Uttar Pradesh - 222001"
TRUST_PHONE_2="+91 75068 62607"
TRUST_EMAIL_2="indiabooks@gmail.com"
TRUST_REGISTERED_OFFICE="A-002, Somnath Apartment, S.V. Cross Road, Chandresh Agency, Asha Nagar, Bhayandar East, Thane, Maharashtra - 401105"
TRUST_PAN=
TRUST_80G_NUMBER=
TRUST_REG_NUMBER=

VITE_APP_NAME="${APP_NAME}"
